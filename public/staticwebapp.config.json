{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/avatars/*", "/manifest.json", "/sw.js", "/*.ico"]
  },
  "mimeTypes": {
    ".json": "application/json",
    ".webmanifest": "application/manifest+json"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN"
  }
}
